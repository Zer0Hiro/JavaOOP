<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="simpleFX2.VotingController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#voteBiden" text="Joe Biden" />
            <Button mnemonicParsing="false" onAction="#voteTrump" text="Donald Trump" />
         </children>
      </HBox>
      <Label fx:id="scoreLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: green; -fx-text-fill: black; -fx-font-size: 14px;" text="0" />
   </children>
</VBox>