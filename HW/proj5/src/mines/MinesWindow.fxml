<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="450.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mines.MinesController">
   <children>
      <VBox alignment="TOP_CENTER" prefWidth="150.0" spacing="10.0">
         <children>
            <Button fx:id="resetButton" maxWidth="1.1797693134862315E308" mnemonicParsing="false" onAction="#handleReset" text="Reset" />
            <HBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label prefWidth="50.0" text="width" />
                  <TextField fx:id="widthInput" text="10" prefWidth="60.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label prefWidth="50.0" text="height" />
                  <TextField fx:id="heightInput" text="10" prefWidth="60.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label prefWidth="50.0" text="mines" />
                  <TextField fx:id="minesInput" text="10" prefWidth="60.0" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="20.0" />
         </padding>
      </VBox>
      <StackPane fx:id="gridContainer" alignment="CENTER" HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </StackPane>
   </children>
</HBox>